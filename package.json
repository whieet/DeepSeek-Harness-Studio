{
  "name": "dsh-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "DeepSeek Harness 桌面版（Tauri，macOS 双架构 + Windows）",
  "type": "module",
  "scripts": {
    "stage": "node scripts/stage-runtime.mjs",
    "dev": "tauri dev",
    "build": "tauri build",
    "build_arm64": "tauri build --target aarch64-apple-darwin",
    "build_x64": "tauri build --target x86_64-apple-darwin",
    "build_win": "tauri build --target x86_64-pc-windows-msvc",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml && node --test scripts/update.test.mjs",
    "icon": "node scripts/gen-icon.mjs && tauri icon scripts/icon-1024.png",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "@ant-design/icons-svg": "^4.5.0",
    "@tauri-apps/cli": "^2"
  }
}
